{
  "name": "rrrtx-freeverse",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "RRRTX FreeVerse \u2014 Free certification platform. Real skills. Real certificates. Forever free.",
  "author": "Muhammad Ahmad (ahmadrrrtx)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run bank:check && vite build && npm run check:client-bundle",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bank:build": "node scripts/build-bank.mjs",
    "bank:validate": "node scripts/build-bank.mjs --report-only",
    "bank:check": "node scripts/check-bank.mjs",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "issuer:keygen": "node scripts/generate-issuer-key.mjs",
    "registry:verify": "node scripts/verify-registry-record.mjs",
    "integration:check": "node scripts/check-learnpath-map.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.445.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.5.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
