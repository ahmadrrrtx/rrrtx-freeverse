# RRRTX FreeVerse — environment variables (NAMES ONLY)
#
# Copy to .env.local for local development: `npm run dev` loads this file and
# serves the real api/*.ts routes through scripts/dev-api.mjs, so the whole
# lifecycle (draw → grade → verify) runs locally. The same names are the
# checklist for the Vercel project (Settings → Environment Variables).
#
#
# Never commit real values. Never print a value into a log or a report — see
# SECURITY_AUDIT.md §Secrets for the incident procedure.

# ── Required for grading (attempts + results) ────────────────────────────────
# 32+ random bytes, base64url. Signs attempt/result tokens and derives the
# credential-id key. Generate: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
FREEVERSE_SIGNING_SECRET=

# ── Required for grading (answer key) ────────────────────────────────────────
# Seals the item bank. If this is absent or wrong, assessments fail closed
# (engine_unavailable) — they never fall back to a public key.
# Generate: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
FREEVERSE_BANK_KEY=

# ── Optional: key rotation while old credentials/attempts are in flight ──────
# JSON map { "<keyId>": "<previous key material>" }. Key ids are the first 8 hex
# characters of sha256(key material) and are printed in server/bank/manifest.json.
FREEVERSE_BANK_KEYS_OLD=

# ── Required for credential issuance ─────────────────────────────────────────
# Ed25519 signing seed. Generate with `npm run issuer:keygen`
# (writes .env.local; prints the public key for publication).
FREEVERSE_ISSUER_KEY=

# ── Required for credential issuance ─────────────────────────────────────────
# GitHub fine-grained PAT scoped to the registry repository ONLY, with
# Contents: Read and write. It is read from the server environment and is never
# exposed to the client bundle (scripts/check-client-bundle.mjs enforces this).
GH_REGISTRY_TOKEN=

# ── Optional overrides ───────────────────────────────────────────────────────
# Registry target (default: ahmadrrrtx/rrrtx-freeverse-certs)
FREEVERSE_REGISTRY_REPO=
# Registry branch (default: main)
FREEVERSE_REGISTRY_BRANCH=
# Extra origins allowed to call the API, comma-separated. same-origin is
# always allowed; everything else is refused (403 origin_rejected).
FREEVERSE_ALLOWED_ORIGINS=
# Canonical public origin used in verify URLs and QR codes.
FREEVERSE_VERIFY_BASE_URL=
# "1" refuses to start an attempt on a topic whose item bank has not passed the
# automated quality gate. Default: off, because every topic is currently
# 'under-review' — turning it on pauses all 15 topics (documented, not a bug).
FREEVERSE_REQUIRE_VERIFIED_BANK=
